// The seven chords of the key as cells, as the printed wheel shows them: the degree in the major key on
// a light tag, the chord, the degree in the relative minor on a dark tag; marked by what the chord does.
import { Theme } from "@jovee-theme/theme.slint";
import { Look, Function, LitText } from "theme.slint";

export struct ChordCard {
    roman: string,         // degree in the major key
    name: string,
    minor-roman: string,   // degree in the relative minor
    function: int,         // in the major key
}

component Tag inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    width: 64px;
    height: 28px;
    border-radius: Theme.radius-sm;
    Text {
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: Theme.display;
        font-size: 22px;
        letter-spacing: 1.3px;
        color: root.ink;
    }
}

component Cell inherits Rectangle {
    in property <ChordCard> chord;
    in property <bool> on;           // the chord sounding now
    in property <bool> compact;
    border-radius: Theme.is-rack ? Theme.radius-sm : Theme.radius;
    background: self.on ? (Theme.is-rack ? Look.display : Look.accent-soft)
        : Theme.is-rack ? Theme.well : Function.soft(self.chord.function);
    border-width: self.on ? Look.chosen : Look.hair;
    border-color: self.on ? Theme.accent
        : Theme.is-rack ? Colors.black : Theme.is-neon ? Theme.line : Theme.line-soft;
    drop-shadow-blur: self.on ? Look.halo : 0;
    drop-shadow-color: Look.halo-color;
    // inside a child, so the stripe follows the rounded corners without clipping the glow
    Rectangle {
        border-radius: root.border-radius;
        clip: true;
        if !root.on || Theme.is-classic: Rectangle {
            y: 0;
            height: Theme.is-neon ? Look.mark : Look.track;
            background: Function.color(root.chord.function);
        }
    }
    VerticalLayout {
        padding-top: root.compact ? 10px : 12px;
        padding-bottom: root.compact ? 8px : 10px;
        padding-left: root.compact ? 4px : 6px;
        padding-right: root.compact ? 4px : 6px;
        spacing: root.compact ? 6px : 8px;
        alignment: space-between;
        HorizontalLayout {
            alignment: center;
            Tag {
                text: root.chord.roman;
                ink: Theme.page;
                background: Theme.ink;
            }
        }
        LitText {
            // the cap height of the name, not its line: keeps the song page's cells as short as drawn
            height: root.compact ? 30px : 38px;
            text: root.chord.name;
            font-size: root.compact ? 30px : 34px;
            font-weight: 700;
            ink: root.on ? Theme.accent : Theme.ink;
            lit: root.on && Theme.is-rack;
        }
        HorizontalLayout {
            alignment: center;
            Tag {
                text: root.chord.minor-roman;
                ink: Theme.ink;
                background: Theme.well;
                border-width: Look.hair;
                border-color: Theme.line;
            }
        }
    }
    accessible-role: text;
    accessible-label: @tr("{} {}, {}", self.chord.roman, self.chord.name, Function.name(self.chord.function));
}

export component FieldCells inherits HorizontalLayout {
    in property <[ChordCard]> chords;
    in property <int> lit: -1;        // the chord sounding, -1 for none
    in property <bool> compact;       // the smaller cells of the song page
    in property <length> cell-height;
    spacing: Theme.sp2;
    for c[i] in root.chords: Cell {
        chord: c;
        on: i == root.lit;
        compact: root.compact;
        // all seven the same width, whatever the length of the name
        preferred-width: 64px;
        horizontal-stretch: 1;
        height: root.cell-height > 0 ? root.cell-height : self.preferred-height;
    }
}

component Swatch inherits HorizontalLayout {
    in property <int> function;
    spacing: Theme.sp2;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: Theme.radius-sm;
            background: Function.color(root.function);
        }
    }
    Text {
        text: Function.name(root.function);
        vertical-alignment: center;
        font-size: Theme.fs-body;
        font-weight: 500;
        color: Theme.ink-2;
    }
}

export component FunctionLegend inherits HorizontalLayout {
    spacing: Theme.sp5;
    alignment: start;
    Swatch { function: 0; }
    Swatch { function: 1; }
    Swatch { function: 2; }
}
