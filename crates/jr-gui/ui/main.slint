// The JoVee Ruler window, in whichever JoVee look `Theme.index` picks: the header on top, the body under
// it. Standalone it has two pages, the harmonic field and the scale; a host (JoVee Jam) opens it on the
// third, one guitar of the song playing.
import { Theme } from "@jovee-theme/theme.slint";
import { Card } from "@jovee-theme/card.slint";
import { FieldCaption } from "@jovee-theme/field_caption.slint";
import { Segmented } from "@jovee-theme/segmented.slint";
import { WindowHeader } from "@jovee-theme/window_header.slint";
import { Well } from "theme.slint";
import { Wheel } from "wheel.slint";
import { FieldCells, FunctionLegend, ChordCard } from "field.slint";
import { Neck, NoteMark, MarkLegend } from "neck.slint";
import { SongView, NowNote, PhraseChip } from "song.slint";

export { Theme } from "@jovee-theme/theme.slint";
export { ChordCard, NoteMark, NowNote, PhraseChip }

export struct ShapeButton {
    label: string,
    first: int,
    last: int,
}

export component AppWindow inherits Window {
    title: "JoVee Ruler";
    preferred-width: 1280px;
    preferred-height: 860px;
    min-width: 1280px;
    min-height: 860px;
    background: Theme.window-bg;
    default-font-family: Theme.sans;

    in-out property <int> page;           // 0 harmonic field, 1 scale, 2 the song in JoVee Jam
    in property <string> brand: "JoVee Ruler";
    in property <string> context;         // next to the brand: the song, inside JoVee Jam

    // the harmonic field and the scale share the key
    in property <[string]> keys;
    in property <int> key-index;
    in property <string> key-title;
    in property <string> key-subtitle;
    in property <string> key-short;
    in property <string> relative-short;
    in property <[ChordCard]> chords;
    callback key-picked(int);

    in property <[ShapeButton]> shapes;
    in property <[string]> shape-options;   // the same shapes, as the control takes them
    in property <int> shape;              // index into `shapes`
    in property <string> shape-subtitle;
    in property <[NoteMark]> scale-notes;
    callback shape-picked(int);

    // the song: the guitar followed, the scale and the shape shown, and the notes as they play
    in property <[string]> guitars;
    in property <int> guitar;
    callback guitar-picked(int);
    in property <int> scale;              // 0 major, 1 pentatonic
    callback scale-picked(int);
    in property <[string]> hand-options;
    in property <int> hand;               // 0 follows the hand, 1-5 a shape, 6 the whole neck
    callback hand-picked(int);
    in property <string> tuning;
    in property <string> song-title;
    in property <string> song-subtitle;
    in property <[NoteMark]> song-notes;
    in property <[string]> open-names;
    in property <int> song-frets: 15;
    in property <int> song-first: -1;
    in property <int> song-last: -1;
    in property <NowNote> now-note;
    in property <[PhraseChip]> phrase;
    callback seek(int);                   // a moment of the song, as `PhraseChip.index` gives it

    VerticalLayout {
        WindowHeader {
            icon: @image-url("icons/mark.svg");
            title: root.brand;
            if root.page == 2 && root.context != "": Text {
                text: root.context;
                vertical-alignment: center;
                font-size: Theme.fs-body;
                font-weight: 500;
                color: Theme.ink-2;
            }
        }

        VerticalLayout {
            padding: Theme.sp4;
            spacing: Theme.sp4;
            vertical-stretch: 1;

            if root.page < 2: HorizontalLayout {
                alignment: start;
                Segmented {
                    label: @tr("Página");
                    options: [@tr("Campo harmônico"), @tr("Escala")];
                    current: root.page;
                    picked(i) => { root.page = i; }
                }
            }

            if root.page == 0: HorizontalLayout {
                spacing: Theme.sp4;
                vertical-stretch: 1;
                Card {
                    width: 560px;
                    // centred, not stretched: the wheel's fixed size must not cap the height of the row
                    VerticalLayout {
                        alignment: center;
                        vertical-stretch: 1;
                        HorizontalLayout {
                            alignment: center;
                            Wheel {
                                keys: root.keys;
                                selected: root.key-index;
                                key-name: root.key-short;
                                relative: root.relative-short;
                                pick(i) => { root.key-picked(i); }
                            }
                        }
                    }
                }
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Theme.sp2;
                        spacing: 28px;
                        alignment: center;
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: Theme.sp1;
                            FieldCaption { text: @tr("Tom"); }
                            Text {
                                text: root.key-title;
                                font-family: Theme.display;
                                font-size: 64px;
                                letter-spacing: 1.9px;
                                color: Theme.ink;
                            }
                            Text {
                                text: root.key-subtitle;
                                font-size: Theme.fs-body;
                                color: Theme.ink-2;
                            }
                        }
                        FieldCells {
                            chords: root.chords;
                            cell-height: 168px;
                        }
                        FunctionLegend { }
                        Text {
                            text: @tr("Em cima o grau no tom maior, embaixo na relativa menor. Gire a roda ou clique numa nota.");
                            font-size: Theme.fs-body;
                            color: Theme.ink-3;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.page == 1: VerticalLayout {
                spacing: Theme.sp4;
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: Theme.sp4;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.sp1;
                        Text {
                            text: root.key-title;
                            font-family: Theme.display;
                            font-size: 48px;
                            letter-spacing: 1.4px;
                            color: Theme.ink;
                        }
                        Text {
                            text: root.shape-subtitle;
                            font-size: Theme.fs-body;
                            color: Theme.ink-2;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        FieldCaption { text: @tr("Forma"); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Segmented {
                            label: @tr("Forma");
                            options: root.shape-options;
                            current: root.shape;
                            picked(i) => { root.shape-picked(i); }
                        }
                    }
                }
                Well {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 10px;
                        alignment: center;
                        Neck {
                            notes: root.scale-notes;
                            window-first: root.shape < 0 ? -1 : root.shapes[root.shape].first;
                            window-last: root.shape < 0 ? -1 : root.shapes[root.shape].last;
                        }
                    }
                }
                MarkLegend { }
            }

            if root.page == 2: SongView {
                vertical-stretch: 1;
                guitars: root.guitars;
                guitar: root.guitar;
                scale: root.scale;
                tuning: root.tuning;
                title: root.song-title;
                subtitle: root.song-subtitle;
                hand-options: root.hand-options;
                hand: root.hand;
                notes: root.song-notes;
                open-names: root.open-names;
                frets: root.song-frets;
                first: root.song-first;
                last: root.song-last;
                now: root.now-note;
                phrase: root.phrase;
                guitar-picked(i) => { root.guitar-picked(i); }
                scale-picked(i) => { root.scale-picked(i); }
                hand-picked(i) => { root.hand-picked(i); }
                seek(i) => { root.seek(i); }
            }
        }
    }
}
