// The JoVee Ruler window, in whichever JoVee look `Theme.index` picks: the header on top, the body under
// it. Standalone it has two pages, the harmonic field and the scale; a host (JoVee Jam) opens it on the
// third, the song playing.
import { Theme } from "@jovee-theme/theme.slint";
import { Look, Label, Panel, Well, Segment, SegControl } from "theme.slint";
import { Wheel } from "wheel.slint";
import { FieldCells, FunctionLegend, ChordCard } from "field.slint";
import { Neck, NoteMark, MarkLegend } from "neck.slint";
import { JamView, Moment } from "jam.slint";

export { Theme } from "@jovee-theme/theme.slint";
export { ChordCard, NoteMark, Moment, Segment }

export struct ShapeButton {
    label: string,
    first: int,
    last: int,
}

// The ruler's mark in the header: a dial with its pointer.
component Mark inherits Rectangle {
    width: 22px;
    height: 22px;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: Look.mark;
        border-color: Theme.accent;
    }
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.accent;
        drop-shadow-blur: Theme.is-classic ? 0 : 5px;
        drop-shadow-color: Look.halo-color;
    }
    Rectangle {
        x: 10px;
        y: 2px;
        width: 2px;
        height: 4px;
        background: Theme.accent;
    }
}

component Toolbar inherits Rectangle {
    in property <string> title;
    in property <string> context;   // the song, inside JoVee Jam
    height: 60px;
    background: Theme.is-rack ? Theme.window-bg : Theme.hdr;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: Theme.sp3;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Mark { }
        }
        Text {
            text: root.title;
            vertical-alignment: center;
            font-family: Theme.display;
            font-size: Theme.fs-head;
            letter-spacing: 1.6px;
            color: Theme.ink;
        }
        if root.context != "": Text {
            text: root.context;
            vertical-alignment: center;
            font-size: Theme.fs-body;
            font-weight: 500;
            color: Theme.ink-2;
        }
    }
    Rectangle {
        y: parent.height - Look.hair;
        height: Look.hair;
        background: Theme.is-rack ? Colors.black : Theme.is-neon ? Theme.line-soft : Theme.well-2;
    }
}

export component AppWindow inherits Window {
    title: "JoVee Ruler";
    preferred-width: 1280px;
    preferred-height: 860px;
    min-width: 1280px;
    min-height: 860px;
    background: Theme.window-bg;
    default-font-family: Theme.sans;

    in-out property <int> page;           // 0 harmonic field, 1 scale, 2 the song in JoVee Jam
    in property <string> brand: "JoVee Ruler";
    in property <string> context;         // next to the brand: the song, inside JoVee Jam

    // the harmonic field and the scale share the key
    in property <[string]> keys;
    in property <int> key-index;
    in property <string> key-title;
    in property <string> key-subtitle;
    in property <string> key-short;
    in property <string> relative-short;
    in property <[ChordCard]> chords;
    callback key-picked(int);

    in property <[ShapeButton]> shapes;
    in property <[Segment]> shape-segments;   // the same shapes, as the control draws them
    in property <int> shape;              // index into `shapes`
    in property <string> shape-subtitle;
    in property <[NoteMark]> scale-notes;
    callback shape-picked(int);

    in property <[string]> timeline;      // the chords on the strip, not the whole song
    in property <int> timeline-first;     // where they start in the song
    in property <int> now;                // in the song, as `seek` is
    in property <Moment> moment;
    in property <[ChordCard]> jam-field;
    in property <[NoteMark]> jam-notes;
    in property <int> jam-first;
    in property <int> jam-last;
    callback seek(int);

    VerticalLayout {
        Toolbar {
            title: root.brand;
            context: root.page == 2 ? root.context : "";
        }

        VerticalLayout {
            padding: Theme.sp4;
            spacing: Theme.sp4;
            vertical-stretch: 1;

            if root.page < 2: HorizontalLayout {
                alignment: start;
                SegControl {
                    items: [{ label: @tr("Campo harmônico") }, { label: @tr("Escala") }];
                    selected: root.page;
                    picked(i) => { root.page = i; }
                }
            }

            if root.page == 0: HorizontalLayout {
                spacing: Theme.sp4;
                vertical-stretch: 1;
                Panel {
                    width: 560px;
                    Wheel {
                        keys: root.keys;
                        selected: root.key-index;
                        key-name: root.key-short;
                        relative: root.relative-short;
                        pick(i) => { root.key-picked(i); }
                    }
                }
                Panel {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 28px;
                        spacing: 28px;
                        alignment: center;
                        VerticalLayout {
                            spacing: Theme.sp1;
                            Label { text: @tr("TOM"); }
                            Text {
                                text: root.key-title;
                                font-family: Theme.display;
                                font-size: 64px;
                                letter-spacing: 1.9px;
                                color: Theme.ink;
                            }
                            Text {
                                text: root.key-subtitle;
                                font-size: Theme.fs-body;
                                color: Theme.ink-2;
                            }
                        }
                        FieldCells {
                            chords: root.chords;
                            cell-height: 168px;
                        }
                        FunctionLegend { }
                        Text {
                            text: @tr("Em cima o grau no tom maior, embaixo na relativa menor. Gire a roda ou clique numa nota.");
                            font-size: Theme.fs-body;
                            color: Theme.ink-3;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.page == 1: VerticalLayout {
                spacing: Theme.sp4;
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: Theme.sp4;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.sp1;
                        Text {
                            text: root.key-title;
                            font-family: Theme.display;
                            font-size: 48px;
                            letter-spacing: 1.4px;
                            color: Theme.ink;
                        }
                        Text {
                            text: root.shape-subtitle;
                            font-size: Theme.fs-body;
                            color: Theme.ink-2;
                        }
                    }
                    Label {
                        text: @tr("FORMA");
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        SegControl {
                            items: root.shape-segments;
                            selected: root.shape;
                            picked(i) => { root.shape-picked(i); }
                        }
                    }
                }
                Well {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 10px;
                        alignment: center;
                        Neck {
                            notes: root.scale-notes;
                            window-first: root.shape < 0 ? -1 : root.shapes[root.shape].first;
                            window-last: root.shape < 0 ? -1 : root.shapes[root.shape].last;
                        }
                    }
                }
                MarkLegend { }
            }

            if root.page == 2: JamView {
                vertical-stretch: 1;
                timeline: root.timeline;
                first: root.timeline-first;
                now: root.now;
                moment: root.moment;
                field: root.jam-field;
                notes: root.jam-notes;
                window-first: root.jam-first;
                window-last: root.jam-last;
                seek(i) => { root.seek(i); }
            }
        }
    }
}
