// The JoVee Ruler window, in whichever JoVee look `Theme.index` picks: the header on top, the body under
// it. Standalone it has two pages, the harmonic field and the scale; a host (JoVee Jam) opens it on the
// third, one guitar of the song playing.
import { Theme } from "@jovee-theme/theme.slint";
import { Card } from "@jovee-theme/card.slint";
import { FieldCaption } from "@jovee-theme/field_caption.slint";
import { HoverLabelLayer } from "@jovee-theme/hover_label.slint";
import { Segmented } from "@jovee-theme/segmented.slint";
import { WindowHeader } from "@jovee-theme/window_header.slint";
import { Locale } from "locale.slint";
import { Well } from "theme.slint";
import { Wheel } from "wheel.slint";
import { FieldCells, FunctionLegend, ChordCard } from "field.slint";
import { Neck, NoteMark, MarkLegend } from "neck.slint";
import { SongView, NowNote, PhraseChip } from "song.slint";

export { Theme } from "@jovee-theme/theme.slint";
export { Locale } from "locale.slint";
export { ChordCard, NoteMark, NowNote, PhraseChip }

// A box of the scale: shape 1 to 5 counted in the major key, `minor` the same box counted in the
// relative minor; the whole neck is shape 0 with no frets.
export struct ShapeButton {
    major: int,
    minor: int,
    first: int,
    last: int,
}

export component AppWindow inherits Window {
    title: "JoVee Ruler";
    preferred-width: 1280px;
    preferred-height: 860px;
    min-width: 1280px;
    min-height: 860px;
    background: Theme.window-bg;
    default-font-family: Locale.font-family;

    in-out property <int> page;           // 0 harmonic field, 1 scale, 2 the song in JoVee Jam
    in property <string> brand: "JoVee Ruler";
    in property <string> context;         // next to the brand: the song, inside JoVee Jam

    // the harmonic field and the scale share the key
    in property <[string]> keys;
    in property <int> key-index;
    in property <string> key-short;       // the flat a lowercase "b": "Ab"
    in property <string> relative-name;   // the tonic of the relative minor: "F"
    in property <string> relative-short;  // the same as the wheel writes it: "Fm"
    in property <string> key-title: @tr("{} major", root.key-short);
    in property <string> key-subtitle: @tr("Relative: {} minor", root.relative-name);
    in property <[ChordCard]> chords;
    callback key-picked(int);

    in property <[ShapeButton]> shapes;
    in property <int> shape;              // index into `shapes`
    in property <[NoteMark]> scale-notes;
    callback shape-picked(int);
    private property <ShapeButton> shape-on: root.shape >= 0 && root.shape < root.shapes.length
        ? root.shapes[root.shape] : { first: -1, last: -1 };
    out property <string> shape-subtitle: root.shape-on.major > 0
        ? @tr("Shape {} · {} in the relative minor · frets {} to {}", root.shape-on.major, root.shape-on.minor, root.shape-on.first, root.shape-on.last)
        : @tr("Whole neck · all five shapes");

    // the song: the guitar followed, the scale and the shape shown, and the notes as they play
    in property <[string]> guitars;
    in property <int> guitar;
    callback guitar-picked(int);
    in property <int> scale;              // 0 major, 1 pentatonic
    callback scale-picked(int);
    in property <int> hand;               // 0 follows the hand, 1-5 a shape, 6 the whole neck
    callback hand-picked(int);
    in property <int> song-shape;         // the shape on show, 1 to 5; 0 = the whole neck
    in property <string> tuning;
    private property <string> guitar-name: root.guitar >= 0 && root.guitar < root.guitars.length ? root.guitars[root.guitar] : "";
    out property <string> song-title: root.scale == 1 ? @tr("{} · pentatonic", root.key-title) : root.key-title;
    out property <string> song-subtitle: root.song-shape == 0 ? @tr("Guitar {} · whole neck", root.guitar-name)
        : root.hand == 0 ? @tr("Guitar {} · the hand is in shape {}, frets {} to {}", root.guitar-name, root.song-shape, root.song-first, root.song-last)
        : @tr("Guitar {} · shape {}, frets {} to {}", root.guitar-name, root.song-shape, root.song-first, root.song-last);
    in property <[NoteMark]> song-notes;
    in property <[string]> open-names;
    in property <int> song-frets: 15;
    in property <int> song-first: -1;
    in property <int> song-last: -1;
    in property <NowNote> now-note;
    in property <[PhraseChip]> phrase;
    callback seek(int);                   // a moment of the song, as `PhraseChip.index` gives it
    in property <bool> high-on-top: true; // the song's neck: the highest string on the top line
    callback strings-flipped();

    VerticalLayout {
        WindowHeader {
            icon: @image-url("icons/mark.svg");
            title: root.brand;
            if root.page == 2 && root.context != "": Text {
                text: root.context;
                vertical-alignment: center;
                font-size: Theme.fs-body;
                font-weight: 500;
                color: Theme.ink-2;
            }
        }

        VerticalLayout {
            padding: Theme.sp4;
            spacing: Theme.sp4;
            vertical-stretch: 1;

            if root.page < 2: HorizontalLayout {
                alignment: start;
                Segmented {
                    label: @tr("Page");
                    options: [@tr("Harmonic field"), @tr("Scale")];
                    current: root.page;
                    picked(i) => { root.page = i; }
                }
            }

            if root.page == 0: HorizontalLayout {
                spacing: Theme.sp4;
                vertical-stretch: 1;
                Card {
                    width: 560px;
                    // centred, not stretched: the wheel's fixed size must not cap the height of the row
                    VerticalLayout {
                        alignment: center;
                        vertical-stretch: 1;
                        HorizontalLayout {
                            alignment: center;
                            Wheel {
                                keys: root.keys;
                                selected: root.key-index;
                                key-name: root.key-short;
                                relative: root.relative-short;
                                pick(i) => { root.key-picked(i); }
                            }
                        }
                    }
                }
                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Theme.sp2;
                        spacing: 28px;
                        alignment: center;
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: Theme.sp1;
                            FieldCaption { text: @tr("Key"); }
                            // not the display font: its capitals only would turn the flat in "Ab" into "AB"
                            Text {
                                text: root.key-title;
                                font-size: 56px;
                                font-weight: 700;
                                color: Theme.ink;
                            }
                            Text {
                                text: root.key-subtitle;
                                font-size: Theme.fs-body;
                                color: Theme.ink-2;
                            }
                        }
                        FieldCells {
                            chords: root.chords;
                            cell-height: 168px;
                        }
                        FunctionLegend { }
                        Text {
                            text: @tr("On top the degree in the major key, below in the relative minor. Turn the wheel or click a note.");
                            font-size: Theme.fs-body;
                            color: Theme.ink-3;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.page == 1: VerticalLayout {
                spacing: Theme.sp4;
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: Theme.sp4;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.sp1;
                        Text {
                            text: root.key-title;
                            font-size: 44px;
                            font-weight: 700;
                            color: Theme.ink;
                        }
                        Text {
                            text: root.shape-subtitle;
                            font-size: Theme.fs-body;
                            color: Theme.ink-2;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        FieldCaption { text: @tr("Shape"); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Segmented {
                            label: @tr("Shape");
                            options: ["1", "2", "3", "4", "5", @tr("Whole neck")];
                            current: root.shape;
                            picked(i) => { root.shape-picked(i); }
                        }
                    }
                }
                Well {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 10px;
                        alignment: center;
                        Neck {
                            notes: root.scale-notes;
                            window-first: root.shape < 0 ? -1 : root.shapes[root.shape].first;
                            window-last: root.shape < 0 ? -1 : root.shapes[root.shape].last;
                        }
                    }
                }
                MarkLegend { }
            }

            if root.page == 2: SongView {
                vertical-stretch: 1;
                guitars: root.guitars;
                guitar: root.guitar;
                scale: root.scale;
                tuning: root.tuning;
                title: root.song-title;
                subtitle: root.song-subtitle;
                hand: root.hand;
                notes: root.song-notes;
                open-names: root.open-names;
                frets: root.song-frets;
                first: root.song-first;
                last: root.song-last;
                now: root.now-note;
                phrase: root.phrase;
                high-on-top: root.high-on-top;
                guitar-picked(i) => { root.guitar-picked(i); }
                scale-picked(i) => { root.scale-picked(i); }
                hand-picked(i) => { root.hand-picked(i); }
                seek(i) => { root.seek(i); }
                strings-flipped => { root.strings-flipped(); }
            }
        }
    }

    HoverLabelLayer { }
}
