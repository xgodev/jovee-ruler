// The JoVee Ruler window. Standalone it has two pages, the harmonic field and the scale; a host
// (JoVee Jam) opens it on the third, the song playing.
import { Theme } from "theme.slint";
import { Wheel } from "wheel.slint";
import { FieldCards, FunctionLegend, ChordCard } from "field.slint";
import { Neck, NoteMark, MarkLegend } from "neck.slint";
import { JamView, FieldCell, Moment } from "jam.slint";

export { ChordCard, NoteMark, FieldCell, Moment }

export struct ShapeButton {
    label: string,
    first: int,
    last: int,
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 40px;
    width: label.preferred-width + 2 * Theme.sp4;
    border-radius: Theme.radius;
    background: self.on ? #1a2029 : touch.has-hover ? Theme.hover : transparent;
    label := Text {
        text: root.text;
        font-size: Theme.fs-body;
        color: root.on ? Theme.text : Theme.text2;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}

component Choice inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 44px;
    width: max(56px, label.preferred-width + 2 * Theme.sp4);
    border-radius: Theme.radius;
    background: self.on ? Theme.text : touch.has-hover ? Theme.s2 : #1a2029;
    border-width: 1px;
    border-color: self.on ? Theme.text : Theme.field-line;
    label := Text {
        text: root.text;
        font-size: Theme.fs-body;
        font-weight: root.on ? 700 : 400;
        color: root.on ? Theme.bg : Theme.text2;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
}

component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;
    Text {
        text: root.title;
        font-family: Theme.display;
        font-size: Theme.fs-title;
        color: Theme.text;
    }
    Text {
        text: root.subtitle;
        font-size: 20px;
        color: Theme.text2;
    }
}

export component AppWindow inherits Window {
    title: "JoVee Ruler";
    preferred-width: 1280px;
    preferred-height: 860px;
    min-width: 1280px;
    background: Theme.bg;
    default-font-family: Theme.sans;

    in-out property <int> page;           // 0 harmonic field, 1 scale, 2 the song in JoVee Jam
    in property <string> brand: "JoVee Ruler";
    in property <string> context;         // next to the brand: the song, inside JoVee Jam

    // the harmonic field and the scale share the key
    in property <[string]> keys;
    in property <int> key-index;
    in property <string> key-title;
    in property <string> key-subtitle;
    in property <string> key-short;
    in property <string> relative-short;
    in property <[ChordCard]> chords;
    callback key-picked(int);

    in property <[ShapeButton]> shapes;
    in property <int> shape;              // index into `shapes`
    in property <string> shape-subtitle;
    in property <[NoteMark]> scale-notes;
    callback shape-picked(int);

    in property <[string]> timeline;
    in property <int> now;
    in property <Moment> moment;
    in property <[FieldCell]> jam-field;
    in property <[NoteMark]> jam-notes;
    in property <int> jam-first;
    in property <int> jam-last;
    callback seek(int);

    VerticalLayout {
        Rectangle {
            height: 64px;
            background: Theme.bar;
            HorizontalLayout {
                padding-left: Theme.sp5;
                padding-right: Theme.sp5;
                spacing: Theme.sp5;
                alignment: start;
                Text {
                    text: root.brand;
                    vertical-alignment: center;
                    font-family: Theme.display;
                    font-size: 30px;
                    color: Theme.text;
                }
                if root.page < 2: HorizontalLayout {
                    spacing: Theme.sp2;
                    padding-top: Theme.sp3;
                    padding-bottom: Theme.sp3;
                    Tab {
                        text: @tr("Campo harmônico");
                        on: root.page == 0;
                        clicked => { root.page = 0; }
                    }
                    Tab {
                        text: @tr("Escala");
                        on: root.page == 1;
                        clicked => { root.page = 1; }
                    }
                }
                if root.page == 2: Text {
                    text: root.context;
                    vertical-alignment: center;
                    font-size: Theme.fs-body;
                    color: Theme.text2;
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #07090c;
            }
        }

        if root.page == 0: HorizontalLayout {
            padding: Theme.sp6;
            spacing: 48px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Wheel {
                    keys: root.keys;
                    selected: root.key-index;
                    key-name: root.key-short;
                    relative: root.relative-short;
                    pick(i) => { root.key-picked(i); }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: Theme.sp5;
                horizontal-stretch: 1;
                Heading {
                    title: root.key-title;
                    subtitle: root.key-subtitle;
                }
                Rectangle { height: Theme.sp2; }
                FieldCards { chords: root.chords; }
                FunctionLegend { }
                Text {
                    text: @tr("Em cima o grau no tom maior, embaixo na relativa menor. Gire a roda ou clique numa nota.");
                    font-size: Theme.fs-body;
                    color: Theme.text3;
                    wrap: word-wrap;
                }
            }
        }

        if root.page == 1: VerticalLayout {
            padding: Theme.sp6;
            spacing: Theme.sp5;
            alignment: start;
            HorizontalLayout {
                spacing: Theme.sp4;
                Heading {
                    title: root.key-title;
                    subtitle: root.shape-subtitle;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: @tr("Forma");
                    height: 44px;
                    vertical-alignment: center;
                    font-size: Theme.fs-body;
                    color: Theme.text3;
                }
                HorizontalLayout {
                    spacing: Theme.sp2;
                    alignment: center;
                    for s[i] in root.shapes: Choice {
                        text: s.label;
                        on: i == root.shape;
                        clicked => { root.shape-picked(i); }
                    }
                }
            }
            Rectangle {
                background: Theme.well;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: Theme.radius-card;
                HorizontalLayout {
                    padding-top: Theme.sp4;
                    padding-bottom: Theme.sp4;
                    alignment: center;
                    Neck {
                        notes: root.scale-notes;
                        window-first: root.shape < 0 ? -1 : root.shapes[root.shape].first;
                        window-last: root.shape < 0 ? -1 : root.shapes[root.shape].last;
                    }
                }
            }
            MarkLegend { }
        }

        if root.page == 2: JamView {
            padding-left: Theme.sp6;
            padding-right: Theme.sp6;
            padding-top: Theme.sp5;
            padding-bottom: Theme.sp5;
            timeline: root.timeline;
            now: root.now;
            moment: root.moment;
            field: root.jam-field;
            notes: root.jam-notes;
            window-first: root.jam-first;
            window-last: root.jam-last;
            seek(i) => { root.seek(i); }
        }
    }
}
