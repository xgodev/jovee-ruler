// The ruler inside JoVee Jam: the host sends the key of the song and the notes sounding now, and this
// shows which chord of the field it is, what it does, and how its notes sit on the pentatonic.
import { Theme, Function, Label, Panel, Pill } from "theme.slint";
import { FieldCells, ChordCard } from "field.slint";
import { Neck, NoteMark, RingLegend } from "neck.slint";

export struct Moment {
    chord: string,          // the chord sounding, as the song names it
    roman: string,          // its degree, "♭VII" when it is borrowed
    accidental: string,     // the "♭" of `roman`, drawn apart: the title face has none
    numeral: string,        // `roman` without it
    function: int,          // -1 when it is outside the field
    lit: int,               // index of the chord in the field, -1 when outside
    field-title: string,
    shape: string,          // the pentatonic shape where the hand is
    outside: string,        // the notes of the chord outside the pentatonic, empty when none
    outside-count: int,
}

export component JamView inherits VerticalLayout {
    in property <[string]> timeline;
    in property <int> now;
    in property <Moment> moment;
    in property <[ChordCard]> field;
    in property <[NoteMark]> notes;
    in property <int> window-first;
    in property <int> window-last;
    callback seek(int);

    spacing: Theme.sp-m;

    // the chords of the song, the one sounding in the accent
    Rectangle {
        height: 56px;
        border-radius: Theme.radius;
        border-width: Theme.line;
        border-color: Theme.field-line;
        background: Theme.panel;
        clip: true;
        HorizontalLayout {
            padding: Theme.line;
            for name[i] in root.timeline: chord := Rectangle {
                horizontal-stretch: 1;
                background: i == root.now ? Theme.accent : touch.has-hover ? Theme.hover : transparent;
                if i > 0: Rectangle {
                    x: 0;
                    width: Theme.line;
                    background: Theme.hair;
                }
                Text {
                    text: name;
                    font-size: 24px;
                    font-weight: 700;
                    color: i == root.now ? Theme.on-accent : i < root.now ? Theme.ink-3 : Theme.ink;
                }
                touch := TouchArea {
                    clicked => { root.seek(i); }
                }
                accessible-role: button;
                accessible-label: name;
                accessible-checked: i == root.now;
                accessible-action-default => { root.seek(i); }
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.sp-m;
        Rectangle {
            width: 300px;
            border-radius: Theme.radius;
            background: Theme.accent-soft;
            border-width: Theme.mark;
            border-color: Theme.accent;
            VerticalLayout {
                padding-top: Theme.sp-m;
                padding-bottom: 16px;
                padding-left: 18px;
                padding-right: 18px;
                spacing: 6px;
                alignment: start;
                Label {
                    text: @tr("AGORA");
                    color: Theme.accent;
                }
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    Text {
                        text: root.moment.chord;
                        font-size: 72px;
                        font-weight: 700;
                        color: Theme.ink;
                    }
                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 6px;
                        HorizontalLayout {
                            alignment: start;
                            if root.moment.accidental != "": Text {
                                text: root.moment.accidental;
                                vertical-alignment: bottom;
                                font-size: 48px;
                                font-weight: 600;
                                color: Theme.ink-2;
                            }
                            Text {
                                text: root.moment.numeral;
                                vertical-alignment: bottom;
                                font-family: Theme.display;
                                font-size: 48px;
                                letter-spacing: 1.9px;
                                color: Theme.ink-2;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Pill {
                        text: Function.name(root.moment.function);
                        ink: Function.ink(root.moment.function);
                        tint: Function.soft(root.moment.function);
                    }
                }
            }
        }
        Panel {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: Theme.sp-m;
                padding-bottom: 16px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Label { text: root.moment.field-title; }
                FieldCells {
                    chords: root.field;
                    lit: root.moment.lit;
                    compact: true;
                }
                HorizontalLayout {
                    spacing: Theme.sp-m;
                    alignment: start;
                    Text {
                        text: root.moment.shape;
                        vertical-alignment: center;
                        font-size: Theme.min-font;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    Pill {
                        text: root.moment.outside-count == 0 ? @tr("todas as notas do acorde estão nela")
                            : root.moment.outside-count == 1 ? @tr("{} do acorde fica fora", root.moment.outside)
                            : @tr("{} do acorde ficam fora", root.moment.outside);
                        ink: root.moment.outside-count == 0 ? Theme.ok-ink : Theme.bad-ink;
                        tint: root.moment.outside-count == 0 ? Theme.ok-soft : Theme.bad-soft;
                    }
                }
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        border-radius: Theme.radius;
        background: Theme.field;
        border-width: Theme.line;
        border-color: Theme.hair;
        VerticalLayout {
            padding: Theme.sp-s;
            alignment: center;
            Neck {
                notes: root.notes;
                window-first: root.window-first;
                window-last: root.window-last;
                sp: 62px;
                r: 21px;
            }
        }
    }

    RingLegend { }
}
