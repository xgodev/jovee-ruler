// The ruler inside JoVee Jam: the host sends the key of the song and the notes sounding now, and this
// shows which chord of the field it is, what it does, and how its notes sit on the pentatonic.
import { Theme } from "@jovee-theme/theme.slint";
import { Look, Function, Label, LitText, Panel, Pill, Well } from "theme.slint";
import { FieldCells, ChordCard } from "field.slint";
import { Neck, NoteMark, RingLegend } from "neck.slint";

export struct Moment {
    chord: string,          // the chord sounding, as the song names it
    roman: string,          // its degree, "♭VII" when it is borrowed
    accidental: string,     // the "♭" of `roman`, drawn apart: the title face has none
    numeral: string,        // `roman` without it
    function: int,          // -1 when it is outside the field
    lit: int,               // index of the chord in the field, -1 when outside
    field-title: string,
    shape: string,          // the pentatonic shape where the hand is
    outside: string,        // the notes of the chord outside the pentatonic, empty when none
    outside-count: int,
}

export component JamView inherits VerticalLayout {
    in property <[string]> timeline;
    in property <int> first;      // the place of `timeline[0]` in the song; `now` and `seek` count from the song's start
    in property <int> now;
    in property <Moment> moment;
    in property <[ChordCard]> field;
    in property <[NoteMark]> notes;
    in property <int> window-first;
    in property <int> window-last;
    callback seek(int);

    spacing: Theme.sp4;

    // the chords around the one sounding, which is in the accent
    Well {
        height: 56px;
        classic: Theme.surf-hi;
        clip: true;
        HorizontalLayout {
            padding: Look.hair;
            for name[i] in root.timeline: chord := Rectangle {
                private property <int> place: root.first + i;
                private property <bool> on: self.place == root.now;
                // all the same width, whatever the names: the strip must not shift as the song moves
                preferred-width: 64px;
                horizontal-stretch: 1;
                background: !self.on ? (touch.has-hover ? Look.hover : transparent)
                    : Theme.is-rack ? Look.display : Theme.accent;
                border-width: self.on && Theme.is-rack ? Look.hair : 0;
                border-color: Look.display-edge;
                if i > 0: Rectangle {
                    x: 0;
                    width: Look.hair;
                    background: Theme.line-soft;
                }
                LitText {
                    text: name;
                    font-size: 24px;
                    font-weight: 700;
                    ink: !chord.on ? (chord.place < root.now ? Theme.ink-3 : Theme.ink)
                        : Theme.is-rack ? Theme.accent : Look.on-accent;
                    lit: chord.on && Theme.is-rack;
                }
                touch := TouchArea {
                    clicked => { root.seek(chord.place); }
                }
                accessible-role: button;
                accessible-label: name;
                accessible-checked: self.on;
                accessible-action-default => { root.seek(self.place); }
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.sp4;
        Rectangle {
            width: 300px;
            border-radius: Theme.is-rack ? Theme.radius : Theme.radius-card;
            background: Theme.is-rack ? Theme.well : Look.accent-soft;
            border-width: Theme.is-rack ? Look.hair : Look.chosen;
            border-color: Theme.is-rack ? Colors.black : Theme.accent;
            drop-shadow-blur: Theme.is-neon ? Look.halo : 0;
            drop-shadow-color: Look.halo-color;
            // the name at its largest, never shown: how wide it is says how much it must shrink to fit
            chord-at-full := Text {
                text: root.moment.chord;
                font-size: 72px;
                font-weight: 700;
                color: transparent;
            }
            VerticalLayout {
                padding-top: 14px;
                padding-bottom: Theme.sp4;
                padding-left: 18px;
                padding-right: 18px;
                spacing: 6px;
                alignment: start;
                Label {
                    text: @tr("AGORA");
                    color: Theme.accent;
                }
                HorizontalLayout {
                    spacing: Theme.sp4;
                    alignment: start;
                    LitText {
                        // the height of the largest size: a long name must not move what is under it
                        height: 86px;
                        text: root.moment.chord;
                        // the card is narrow, and a song can write "F#m7(onC#)": the name takes what the
                        // degree leaves on the 264px inside the card, with 2px to spare for rounding
                        font-size: min(72px, (264px - 2px - Theme.sp4 - degree.preferred-width) / chord-at-full.preferred-width * 72px);
                        font-weight: 700;
                        ink: Theme.is-rack ? Theme.accent : Theme.ink;
                        lit: Theme.is-rack;
                    }
                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 6px;
                        degree := HorizontalLayout {
                            alignment: start;
                            if root.moment.accidental != "": Text {
                                text: root.moment.accidental;
                                vertical-alignment: bottom;
                                font-size: 40px;
                                font-weight: 600;
                                color: Theme.ink-2;
                            }
                            Text {
                                text: root.moment.numeral;
                                vertical-alignment: bottom;
                                font-family: Theme.display;
                                font-size: 48px;
                                letter-spacing: 1.9px;
                                color: Theme.ink-2;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Pill {
                        text: Function.name(root.moment.function);
                        ink: Function.ink(root.moment.function);
                        tint: Function.soft(root.moment.function);
                        edge: root.moment.function < 0 ? Theme.line : transparent;
                    }
                }
            }
        }
        Panel {
            horizontal-stretch: 1;
            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 18px;
                padding-left: Theme.is-rack ? 28px : Theme.sp4;
                padding-right: Theme.is-rack ? 28px : Theme.sp4;
                spacing: 10px;
                Label { text: root.moment.field-title.to-uppercase(); }
                FieldCells {
                    chords: root.field;
                    lit: root.moment.lit;
                    compact: true;
                }
                HorizontalLayout {
                    spacing: Theme.sp4;
                    alignment: start;
                    Text {
                        text: root.moment.shape;
                        vertical-alignment: center;
                        font-size: Theme.fs-body;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    Pill {
                        text: root.moment.outside-count == 0 ? @tr("todas as notas do acorde estão nela")
                            : root.moment.outside-count == 1 ? @tr("{} do acorde fica fora", root.moment.outside)
                            : @tr("{} do acorde ficam fora", root.moment.outside);
                        ink: Function.ink(root.moment.outside-count == 0 ? 0 : 2);
                        tint: Function.soft(root.moment.outside-count == 0 ? 0 : 2);
                    }
                }
            }
        }
    }

    Well {
        vertical-stretch: 1;
        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 6px;
            alignment: center;
            Neck {
                notes: root.notes;
                window-first: root.window-first;
                window-last: root.window-last;
                sp: 62px;
                r: 21px;
            }
        }
    }

    RingLegend { }
}
