// What the ruler adds to the JoVee looks (`@jovee-theme`, picked by `Theme.index`): the tints it derives
// from their tokens, the colours of a chord's function, and the few controls it draws. One layout for
// the three looks; what only one look draws (Rack screws and displays, Neon outlines) asks `Theme.is-*`.
import { Theme } from "@jovee-theme/theme.slint";

export global Look {
    out property <color> on-accent: Theme.well-2;
    out property <color> accent-soft: Theme.accent.with-alpha(0.14);
    out property <color> hover: Theme.ink.with-alpha(0.05);
    // Rack's amber display: a dark well with the accent barely in it, and its edge
    out property <color> display: Theme.accent.mix(Theme.well, 0.06);
    out property <color> display-edge: Theme.accent.mix(Theme.well, 0.25);
    // the outline of what is chosen, thinner where it glows
    out property <length> chosen: Theme.is-classic ? 2px : Theme.is-neon ? 1.5px : 1px;
    // the blur and colour of that glow
    out property <length> halo: Theme.is-neon ? 18px : Theme.is-rack ? 12px : 0px;
    out property <color> halo-color: Theme.is-classic ? transparent : Theme.accent.with-alpha(0.45);
    // hairlines and the thicker marks
    out property <length> hair: 1px;
    out property <length> mark: 2px;
    out property <length> track: 3px;
}

// What a chord does in the key, as the printed wheel colours it: 0 rest, 1 transition, 2 tension;
// anything else is a chord from outside the field.
export global Function {
    public pure function color(f: int) -> color {
        if f == 0 { return Theme.ok; }
        if f == 1 { return Theme.warn; }
        if f == 2 { return Theme.bad; }
        return Theme.ink-3;
    }
    public pure function soft(f: int) -> color {
        if f == 0 || f == 1 || f == 2 { return Function.color(f).with-alpha(0.16); }
        return Theme.well;
    }
    public pure function ink(f: int) -> color {
        if f == 0 { return Theme.ok.mix(Colors.white, 0.55); }
        if f == 1 { return Theme.warn.mix(Colors.white, 0.65); }
        if f == 2 { return Theme.bad.mix(Colors.white, 0.55); }
        return Theme.ink-2;
    }
    public pure function name(f: int) -> string {
        if f == 0 { return @tr("repouso"); }
        if f == 1 { return @tr("transição"); }
        if f == 2 { return @tr("tensão"); }
        return @tr("emprestado, fora do campo");
    }
}

// A caption: uppercase Barlow, as JoVee captions a panel.
export component Label inherits Text {
    font-family: Theme.sans;
    font-size: Theme.fs-body;
    font-weight: 600;
    letter-spacing: 1.6px;
    color: Theme.ink-3;
}

// Text that can light up like an amber display. Slint has no text shadow, so the halo is the same text
// repeated faintly around it.
export component LitText inherits Rectangle {
    in property <string> text;
    in property <length> font-size;
    in property <int> font-weight;
    in property <color> ink;
    in property <bool> lit;

    preferred-width: main.preferred-width;
    preferred-height: main.preferred-height;

    if root.lit: Rectangle {
        for o in [
            { dx: -2px, dy: 0px }, { dx: 2px, dy: 0px }, { dx: 0px, dy: -2px }, { dx: 0px, dy: 2px },
            { dx: -1px, dy: -1px }, { dx: 1px, dy: -1px }, { dx: -1px, dy: 1px }, { dx: 1px, dy: 1px },
        ]: Text {
            x: (root.width - self.width) / 2 + o.dx;
            y: (root.height - self.height) / 2 + o.dy;
            text: root.text;
            font-size: root.font-size;
            font-weight: root.font-weight;
            color: root.ink.with-alpha(0.14);
        }
    }
    main := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.ink;
    }
}

// A Rack panel's screw.
component Screw inherits Rectangle {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: Theme.g-top;
    border-width: Look.hair;
    border-color: Colors.black;
}

// A card: flat slate (Classic), an outline in the dark (Neon), a metal panel with screws (Rack).
export component Panel inherits Rectangle {
    background: Theme.is-rack ? Theme.window-bg : Theme.is-neon ? Theme.ink.with-alpha(0.02) : Theme.surf-hi;
    border-radius: Theme.is-rack ? Theme.radius : Theme.radius-card;
    border-width: Look.hair;
    border-color: Theme.is-rack ? Colors.black : Theme.is-neon ? Theme.line : Theme.line-soft;

    if Theme.is-rack: Rectangle {
        Screw { x: 7px; y: 7px; }
        Screw { x: parent.width - 15px; y: 7px; }
        Screw { x: 7px; y: parent.height - 15px; }
        Screw { x: parent.width - 15px; y: parent.height - 15px; }
    }
    @children
}

// What sits sunk into the panel: the neck, the song's chords. On Rack it is a recess, darker at the top.
export component Well inherits Rectangle {
    in property <color> classic: Theme.well;
    background: Theme.is-rack ? Theme.well : Theme.is-neon ? Theme.ink.with-alpha(0.02) : root.classic;
    border-radius: Theme.is-rack ? Theme.radius : Theme.radius-card;
    border-width: Look.hair;
    border-color: Theme.is-rack ? Colors.black : Theme.line;

    @children
    if Theme.is-rack: Rectangle {
        y: 1px;
        x: 1px;
        width: parent.width - 2px;
        height: 10px;
        border-radius: Theme.radius;
        background: @linear-gradient(180deg, Colors.black.with-alpha(0.7) 0%, Colors.black.with-alpha(0) 100%);
    }
}

// A short fixed set of choices, one on: JoVee's rounded segmented control.
export struct Segment {
    label: string,
    mono: bool,   // a number, drawn in the mono face
}

export component SegControl inherits Rectangle {
    in property <[Segment]> items;
    in property <int> selected;
    callback picked(int);

    height: 34px;
    border-radius: 17px;
    border-width: Look.hair;
    border-color: Theme.is-rack ? Colors.black : Theme.line;
    background: Theme.well-2;

    HorizontalLayout {
        padding: 3px;
        for s[i] in root.items: seg := Rectangle {
            private property <bool> on: i == root.selected;
            min-width: s.mono ? 44px : 0;
            border-radius: 14px;
            background: !self.on ? (touch.has-hover ? Look.hover : transparent)
                : Theme.is-neon ? Theme.accent.with-alpha(0.1)
                : Theme.is-rack ? Look.display : Theme.g-bot;
            border-width: self.on && !Theme.is-classic ? Look.chosen : 0;
            border-color: Theme.is-rack ? Look.display-edge : Theme.accent;
            drop-shadow-blur: self.on && Theme.is-neon ? 12px : 0;
            drop-shadow-color: Look.halo-color;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: s.label.to-uppercase();
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    font-family: s.mono ? Theme.mono : Theme.sans;
                    font-size: Theme.fs-body;
                    font-weight: s.mono ? 500 : 600;
                    letter-spacing: s.mono ? 0 : 1px;
                    color: !seg.on ? Theme.ink-3 : Theme.is-classic ? Theme.ink : Theme.accent;
                }
            }
            touch := TouchArea {
                clicked => { root.picked(i); }
            }
            accessible-role: button;
            accessible-label: s.label;
            accessible-checked: self.on;
            accessible-action-default => { root.picked(i); }
        }
    }
}

// A small tinted tag with a dot: the function of a chord, or what is outside the pentatonic.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    in property <color> tint;
    in property <color> edge: transparent;
    height: 32px;
    width: row.preferred-width;
    border-radius: 16px;
    background: root.tint;
    border-width: Look.hair;
    border-color: root.edge;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.ink;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.fs-body;
            font-weight: 600;
            color: root.ink;
        }
    }
}
