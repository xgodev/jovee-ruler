// The neck from the nut to fret 15, 6th string on top as on the printed ruler, with the slider's marks
// over the notes of the scale: square = tonic, diamond = tonic of the relative minor, circle = pentatonic,
// triangle = the 4th and 7th. Outside the chosen shape the marks fade, as the cassette darkens them.
import { Theme } from "theme.slint";

export struct NoteMark {
    string: int,   // 0 = 6th string, drawn on top
    fret: int,     // 0 = open
    name: string,
    mark: int,     // 0 tonic, 1 tonic of the relative minor, 2 pentatonic, 3 scale, 4 outside the scale
    lit: bool,     // inside the shape on show
    ring: int,     // sounding now: 0 no, 1 inside the pentatonic, 2 outside it
}

component Dot inherits Rectangle {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: Theme.ink-3;
    opacity: 0.3;
}

export component Neck inherits Rectangle {
    in property <[NoteMark]> notes;
    in property <int> frets: 15;
    in property <int> window-first: -1;   // the shape on show, both frets included; -1 = the whole neck
    in property <int> window-last: -1;
    in property <length> sp: 84px;        // between strings
    in property <length> r: 26px;         // of a mark

    height: self.y0 + 5 * self.sp + self.r + 56px;

    private property <length> x0: 100px;
    private property <length> fw: (root.width - 12px - self.x0) / root.frets;
    private property <length> y0: root.r + 18px;
    private property <length> box: 2 * root.r + 20px;   // a mark with room for its ring

    pure function cell-x(f: int) -> length {
        return f == 0 ? root.x0 / 2 + 14px : root.x0 + (f - 0.5) * root.fw;
    }
    // a mark outside the shape, faded into the neck; its colours are mixed, not made transparent, so the
    // name stays readable on the faded mark
    pure function fade(c: color, lit: bool) -> color {
        return lit ? c : c.mix(Theme.field, 0.18);
    }
    pure function inlay(f: int) -> bool {
        return f == 3 || f == 5 || f == 7 || f == 9 || f == 15 || f == 17 || f == 19 || f == 21;
    }

    if root.window-first >= 0: Rectangle {
        x: root.window-first == 0 ? 30px : root.x0 + (root.window-first - 1) * root.fw;
        y: root.y0 - root.r - 10px;
        width: root.x0 + root.window-last * root.fw - self.x;
        height: 5 * root.sp + 2 * root.r + 20px;
        border-radius: Theme.radius;
        background: Theme.accent-soft;
        border-width: Theme.mark;
        border-color: Theme.accent;
    }

    for f in root.frets + 1: Rectangle {
        if f > 0 && root.inlay(f): Dot {
            x: root.cell-x(f) - 7px;
            y: root.y0 + 2.5 * root.sp - 7px;
        }
        if f == 12: Dot {
            x: root.cell-x(f) - 7px;
            y: root.y0 + 1.5 * root.sp - 7px;
        }
        if f == 12: Dot {
            x: root.cell-x(f) - 7px;
            y: root.y0 + 3.5 * root.sp - 7px;
        }
        Rectangle {
            x: root.x0 + f * root.fw - self.width / 2;
            y: root.y0;
            width: f == 0 ? 4px : Theme.line;
            height: 5 * root.sp;
            background: f == 0 ? Theme.ink-2 : Theme.ink-3.with-alpha(0.45);
        }
        Text {
            x: root.cell-x(f) - 20px;
            y: root.y0 + 5 * root.sp + root.r + 22px;
            width: 40px;
            text: f;
            horizontal-alignment: center;
            font-family: Theme.mono;
            font-size: Theme.min-font;
            color: Theme.ink-3;
        }
    }

    for s in 6: Rectangle {
        Rectangle {
            x: root.x0;
            y: root.y0 + s * root.sp - self.height / 2;
            width: root.width - 12px - root.x0;
            height: (2 - s * 0.2) * 1px;
            background: Theme.ink-3;
        }
        Text {
            x: 4px;
            y: root.y0 + s * root.sp - 12px;
            height: 24px;
            text: 6 - s;
            vertical-alignment: center;
            font-family: Theme.mono;
            font-size: Theme.min-font;
            color: Theme.ink-3;
        }
    }

    for n in root.notes: Rectangle {
        x: root.cell-x(n.fret) - root.box / 2;
        y: root.y0 + n.string * root.sp - root.box / 2;
        width: root.box;
        height: root.box;

        if n.ring > 0: Rectangle {
            width: 2 * root.r + 17px;
            height: self.width;
            border-radius: self.width / 2;
            border-width: Theme.track;
            border-color: n.ring == 1 ? Theme.ok : Theme.bad;
        }
        if n.mark == 0: Rectangle {
            width: 2 * root.r;
            height: self.width;
            border-radius: Theme.radius;
            background: root.fade(Theme.accent, n.lit);
        }
        if n.mark == 1: Path {
            width: 2 * root.r + 10px;
            height: self.width;
            viewbox-width: 52;
            viewbox-height: 52;
            commands: "M 26 0 L 52 26 L 26 52 L 0 26 Z";
            fill: root.fade(Theme.ink, n.lit);
        }
        if n.mark == 2: Rectangle {
            width: 2 * root.r;
            height: self.width;
            border-radius: self.width / 2;
            background: root.fade(Theme.ink, n.lit);
        }
        if n.mark == 3: Path {
            y: root.box / 2 - root.r - 2px;
            width: 2 * root.r + 6px;
            height: 2 * root.r + 2px;
            viewbox-width: 48;
            viewbox-height: 44;
            commands: "M 24 0 L 48 44 L 0 44 Z";
            fill: root.fade(Theme.ink-3, n.lit);
        }
        if n.mark == 4: Rectangle {
            width: 2 * root.r;
            height: self.width;
            border-radius: self.width / 2;
            background: root.fade(Theme.panel-lo, n.lit);
            border-width: Theme.line;
            border-color: root.fade(Theme.field-line, n.lit);
        }
        Text {
            y: (root.box - self.height) / 2 + (n.mark == 3 ? 6px : 0);
            text: n.name;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: root.r > 24px ? 20px : 18px;
            font-weight: 700;
            color: root.fade(n.mark == 0 ? Theme.on-accent : n.mark == 4 ? Theme.ink : Theme.field, n.lit);
        }
    }

    accessible-role: image;
    accessible-label: @tr("Braço da guitarra com as notas da escala");
}

component Key inherits HorizontalLayout {
    in property <string> text;
    spacing: 8px;
    @children
    Text {
        text: root.text;
        vertical-alignment: center;
        font-size: Theme.min-font;
        font-weight: 500;
        color: Theme.ink-2;
    }
}

export component MarkLegend inherits HorizontalLayout {
    spacing: 24px;
    alignment: start;
    Key {
        text: @tr("tônica maior");
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: Theme.radius-sm;
            background: Theme.accent;
        }
    }
    Key {
        text: @tr("tônica da relativa menor");
        Path {
            width: 20px;
            height: 20px;
            viewbox-width: 20;
            viewbox-height: 20;
            commands: "M 10 0 L 20 10 L 10 20 L 0 10 Z";
            fill: Theme.ink;
        }
    }
    Key {
        text: @tr("pentatônica");
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: Theme.ink;
        }
    }
    Key {
        text: @tr("graus 4 e 7");
        Path {
            width: 20px;
            height: 18px;
            viewbox-width: 20;
            viewbox-height: 18;
            commands: "M 10 0 L 20 18 L 0 18 Z";
            fill: Theme.ink-3;
        }
    }
}

// The rings of the song page: a chord note inside the pentatonic, or outside it.
export component RingLegend inherits HorizontalLayout {
    spacing: 24px;
    alignment: start;
    Key {
        text: @tr("nota do acorde na pentatônica");
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            border-width: Theme.track;
            border-color: Theme.ok;
        }
    }
    Key {
        text: @tr("nota do acorde fora dela");
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            border-width: Theme.track;
            border-color: Theme.bad;
        }
    }
}
